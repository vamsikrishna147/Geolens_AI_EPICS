# GeoLens AI Environment Template
# Duplicate this file to .env and insert your API keys and credentials.

# --- LLM Providers ---
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_secondary_gemini_api_key_here
GEMINI_API_KEY_3=your_tertiary_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Google Earth Engine & Google Cloud ---
GEE_PROJECT_ID=your_gee_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# --- External Geospatial & Weather APIs ---
NASA_API_KEY=your_nasa_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Database Storage ---
POSTGIS_HOST=localhost
POSTGIS_PORT=5432
POSTGIS_DB=geolens
POSTGIS_USER=postgres
POSTGIS_PASSWORD=your_password
MONGO_URI=mongodb://localhost:27017/geolens
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Application Security ---
ADMIN_SECRET_KEY=your_admin_secret_key_here
